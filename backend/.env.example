# Copy to .env and fill in real values. Never commit the completed .env.

# development | production
NODE_ENV=development
PORT=5000

# SQLite for local work, PostgreSQL connection string in production.
#   sqlite:./evereco_dev.db
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:./evereco_dev.db

# REQUIRED. Signing key for JWTs. Must be a long random string, unique per
# environment. The server refuses to start in production if this is missing or
# left at the placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long an access token stays valid. Keep this short: there is no refresh
# token or server-side revocation, so a leaked token is usable until it expires.
JWT_EXPIRE=30m

# bcrypt cost factor. 10 is the minimum; raise it if the host can afford it.
BCRYPT_ROUNDS=10

# Comma-separated list of browser origins permitted to call this API.
# Set to the deployed front-end URL in production. Never use "*".
CORS_ORIGIN=http://localhost:5173

# Credentials for the seeded administrator. Set a strong, unique password here
# before first run and change it after the initial sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Public URL of the front end. Used to build the links inside outgoing emails,
# so it must be the address users actually open, not the API's.
APP_URL=http://localhost:5173

# Email service configuration. Leave blank to disable (emails logged to console).
# For Gmail with 2FA enabled, use an App Password instead of your main password.
# Get Gmail App Password: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=Evereco Energy HR
