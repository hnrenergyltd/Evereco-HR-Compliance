# ═══════════════════════════════════════════════════════════════
# RAILWAY ENVIRONMENT VARIABLES — BACKEND SERVICE
# ═══════════════════════════════════════════════════════════════
# Set these in Railway: your service -> Variables.
# Every name here matches one the code actually reads; nothing else
# is consulted at runtime.

NODE_ENV=production

# Railway injects PORT itself. Do not set it — the server already reads
# process.env.PORT and binding to the wrong one makes the deploy fail
# its health check.

# ───────────────────────────────────────────────────────────────
# DATABASE
# ───────────────────────────────────────────────────────────────
# Adding Railway's PostgreSQL plugin creates DATABASE_URL automatically;
# reference it as ${{Postgres.DATABASE_URL}} rather than pasting a value.
#
# ⚠️  The application currently targets SQLite. Its queries use SQLite-only
#     syntax (rowid, datetime('now'), PRAGMA) that PostgreSQL rejects, so
#     pointing this at Postgres without porting the SQL first will fail at
#     runtime. See docs/DATABASE.md.
#
# SQLite on a mounted volume (works today):
DATABASE_URL=sqlite:/app/data/evereco.db
#
# PostgreSQL (after the port):
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# ───────────────────────────────────────────────────────────────
# FILE STORAGE
# ───────────────────────────────────────────────────────────────
# Must point inside a mounted Railway Volume. The container filesystem is
# rebuilt on every deploy, so uploaded documents written anywhere else are
# destroyed. Create a Volume and mount it at /app/data.
DOCUMENT_STORAGE_PATH=/app/data/secure_documents

# ───────────────────────────────────────────────────────────────
# AUTHENTICATION
# ───────────────────────────────────────────────────────────────
# REQUIRED. The server refuses to start in production if this is missing or
# left at the placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Access tokens are short-lived: there is no refresh token or server-side
# revocation, so a leaked token stays usable until it expires.
JWT_EXPIRE=30m

BCRYPT_ROUNDS=10

# ───────────────────────────────────────────────────────────────
# ADMIN BOOTSTRAP (first run only)
# ───────────────────────────────────────────────────────────────
# Must satisfy the password policy: 12+ characters, one uppercase, one
# number, one symbol. Change it immediately after the first sign-in.
ADMIN_EMAIL=admin@everecoenergy.com
ADMIN_PASSWORD=

# ───────────────────────────────────────────────────────────────
# CORS AND LINKS
# ───────────────────────────────────────────────────────────────
# Browser origins allowed to call this API, comma-separated. This is the
# deployed front-end URL. Never "*".
CORS_ORIGIN=https://your-frontend.up.railway.app

# Base URL used to build links inside outgoing emails. This is the address
# users open in a browser — the front end, not the API.
APP_URL=https://your-frontend.up.railway.app

# ───────────────────────────────────────────────────────────────
# EMAIL (SMTP)
# ───────────────────────────────────────────────────────────────
# Without these, password-reset and credential emails are written to the
# server log instead of being delivered — which also means credentials end
# up in your Railway logs. Configure them before going live.
# For Gmail, SMTP_PASS must be an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Evereco Energy HR
